                  "enum": [
                    "read_file",
                    "write_file"
                  ]
                },
                "arguments": {
                  "type": "object"
                }
              },
              "required": [
                "name",
                "arguments"
              ]
            }
          },
          "final_report": {
            "type": "string"
          }
        },
        "required": [
          "reasoning",
          "tools"
        ]
      }
    }
  },
