{
  "recipe_id": "fn_dev_dynamic",
  "goal_template": "Implement, debug, and verify execution: {{user_instructions}}",
  "load_modules": [
    {
      "module": "WorkspaceModule",
      "initial_state": {
        "root_dir": "."
      },
      "expose_actions": [
        "create_file",
        "read_region",
        "surgical_edit",
        "outline"
      ]
    },
    {
      "module": "ExecutionModule",
      "initial_state": {
        "test_cmd": "pytest"
      },
      "expose_actions": [
        "ensure_venv",
        "pip_install",
        "run_python",
        "pip_list",
        "exec_sandboxed_cmd",
        "run_test_suite"
      ]
    },
    {
      "module": "KnowledgeModule",
      "initial_state": {},
      "expose_actions": [
        "search_local_docs",
        "store_fact",
        "get_all_facts"
      ]
    },
    {
      "module": "OrchestratorModule",
      "initial_state": {
        "required_fields": [
          "active_objective",
          "current_hypothesis",
          "verified_facts",
          "failed_approaches_do_not_repeat",
          "next_immediate_action"
        ]
      },
      "expose_actions": [
        "checkpoint_notes",
        "complete_recipe",
        "trigger_context_condense"
      ]
    }
  ],
  "pre_llm_hooks": [],
  "scratchpad_checklist": [
    "Write the script or implementation file using WorkspaceModule create_file or ExecutionModule run_python",
    "Install any required third-party packages using ExecutionModule pip_install",
    "Run and verify execution using ExecutionModule run_python",
    "Call OrchestratorModule complete_recipe"
  ]
}
