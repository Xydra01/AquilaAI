{
  "recipe_id": "fn_research_dynamic",
  "goal_template": "Perform dynamic hypothesis-driven research: {{user_instructions}}",
  "load_modules": [
    {
      "module": "KnowledgeModule",
      "initial_state": {},
      "expose_actions": [
        "search_local_docs",
        "store_fact",
        "get_all_facts"
      ]
    },
    {
      "module": "ExecutionModule",
      "initial_state": {
        "test_cmd": "pytest"
      },
      "expose_actions": [
        "ensure_venv",
        "pip_install",
        "run_python",
        "pip_list",
        "exec_sandboxed_cmd",
        "run_test_suite"
      ]
    },
    {
      "module": "WorkspaceModule",
      "initial_state": {
        "root_dir": "."
      },
      "expose_actions": [
        "create_file",
        "read_region",
        "outline"
      ]
    },
    {
      "module": "OrchestratorModule",
      "initial_state": {
        "required_fields": [
          "active_objective",
          "current_hypothesis",
          "verified_facts"
        ]
      },
      "expose_actions": [
        "checkpoint_notes",
        "complete_recipe",
        "trigger_context_condense"
      ]
    }
  ],
  "pre_llm_hooks": [],
  "scratchpad_checklist": [
    "Search local documentation or investigate question using KnowledgeModule search_local_docs",
    "Store verified findings into knowledge memory using KnowledgeModule store_fact",
    "Call OrchestratorModule complete_recipe to finish"
  ]
}
