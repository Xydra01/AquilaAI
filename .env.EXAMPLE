SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=

# Ollama — see Settings → AI Engine or docs/ollama-dual-setup.md
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Recommended for reliable Code Mode (see docs/code-mode.md):
OLLAMA_MODEL=aquila:latest
# OLLAMA_MODEL=aquila_qwopus


# Chat & light research — Light web research in Chat Mode. Pasted URLs in your message are fetched separately from URLs auto-scraped from SearXNG search results.
# How many http(s) links to extract from a single chat message.
# AQUILA_LIGHT_RESEARCH_MAX_USER_URLS=3
# How many of those links are actually downloaded and injected into context.
# AQUILA_LIGHT_RESEARCH_USER_URL_READS=2
# AQUILA_LIGHT_RESEARCH_MAX_SEARCHES=2
# AQUILA_LIGHT_RESEARCH_MAX_QUERY_WORDS=18
# Not the same as pasted user links — caps follow-up page reads from SearXNG hits.
# AQUILA_LIGHT_RESEARCH_MAX_URLS=1
# AQUILA_LIGHT_RESEARCH_MAX_READS=1
# AQUILA_LIGHT_RESEARCH_SCRAPE_CHAR_CAP=8000
# AQUILA_LIGHT_RESEARCH_READ_MAX_CHARS=8000

# Chat & light coding — Repo snapshot injected before chat when Light coding is enabled.
# AQUILA_LIGHT_CODING_TOKEN_BUDGET=20000
# AQUILA_LIGHT_CODING_MAX_FILES_FULL=40
# AQUILA_LIGHT_CODING_FILE_CHAR_CAP=12000
# AQUILA_LIGHT_CODING_MAX_WALK_FILES=2000
# AQUILA_LIGHT_CODING_GREP_MAX=30

# Thinking & chat — Native Qwen thinking and chat generation limits.
# AQUILA_ENABLE_THINK=1
# AQUILA_THINK_SURFACES=chat,character,learn,act,explore,plan,reflect
# AQUILA_ACT_TWO_PHASE=1
# AQUILA_ACT_STRUCTURED_NO_PLAIN=1
# AQUILA_THINK_LEGACY_XML=1
# AQUILA_STRIP_THINK_STREAM=1
# AQUILA_CHAT_NUM_PREDICT=2048
# AQUILA_CHAT_NUM_PREDICT_THINK=4096
# AQUILA_COMPACT_CHAT=0
# AQUILA_REPEAT_PENALTY=1.15
# AQUILA_TQ_REPEAT_PENALTY=1.3
# AQUILA_REPEAT_LAST_N=64
# AQUILA_KILL_SWITCH_MODE=stall

# Tasks & act loop — Tool loop, planning, and task execution.
# AQUILA_ROUTE_TOOLS=1
# AQUILA_ACT_NUM_PREDICT=4096
# Assistant JSON prefill for non-schema act formats only (json_object/plain).
# Never paired with JSON Schema — Ollama returns HTTP 400 (sampler init failure).
# AQUILA_ACT_JSON_PREFILL=1
# AQUILA_ACT_STREAM=1
# AQUILA_LEGACY_ACT_REFLECT=0
# AQUILA_MAX_LOOP_TICKS=50
# AQUILA_FINAL_STEP_STALL_LIMIT=8
# AQUILA_STALL_HALT_TURNS=8
# AQUILA_LLM_ERROR_LIMIT=3
# AQUILA_FAST_PATH=1
# AQUILA_MICRO_PLAN_MAX_WORDS=80
# AQUILA_MICRO_PLAN_CODE_SINGLE=0
# AQUILA_EXPLORE_BRIEF=0
# AQUILA_PLAN_REVIEW=1
# AQUILA_PLAN_AUTO_APPROVE_MICRO=0
# AQUILA_WALKTHROUGH=1
# AQUILA_READ_BATCH=1
# AQUILA_RESEARCH_DRAFT_MIN_CHARS=800
# Research recipe strict mode — auto-run step capability_id on first act turn (QA).
# AQUILA_RESEARCH_RECIPE_STRICT=0

# Dynamic loop — Milestone-driven task loop (experimental).
# AQUILA_DYNAMIC_LOOP=0
# AQUILA_AUTO_ADVANCE_MILESTONES=0
# AQUILA_TASK_EPISODE_MAX=32
# AQUILA_TASK_WEB_SEARCH_CAP=12
# AQUILA_DYNAMIC_SCHEMA_MAX_TOOLS=128

# Learn & character — Temperatures and RAG limits for Learn and Character modes.
# AQUILA_CHARACTER_TEMP=0.8
# AQUILA_LEARN_TUTOR_TEMP=0.7
# AQUILA_LEARN_ARCHIVE_TEMP=0.6
# AQUILA_LEARN_ARCHIVE_TOP_K=5
# AQUILA_LEARN_TUTOR_TOP_K=5
# AQUILA_LEARN_RETRIEVAL_MAX_CHARS=12000
# AQUILA_LEARN_ARCHIVE_GENERATION_CAP=0

# Context & scraping — Web enrichment and context tier for tasks.
# AQUILA_AUTO_SCRAPE=1
# AQUILA_CONTEXT_TIER=
# AQUILA_TOOL_OUTPUT_CHAR_CAP=6000
# AQUILA_TOTAL_PROMPT_TOKEN_CAP=8000

# Structured output — JSON schema tool calling (see docs/structured-output.md).
# AQUILA_STRUCTURED_STRICT=1
# AQUILA_STRUCTURED_NO_PLAIN=0
# AQUILA_SCHEMA_MAX_TOOLS=24

# Ollama & warmup — Cold start, warmup, and inference timeouts.
# AQUILA_WARMUP_ON_START=1
# AQUILA_SKIP_WARMUP=0
# AQUILA_WARMUP_REQUIRED=1
# AQUILA_COLD_START_EXTRA_SEC=90
# AQUILA_COLD_START_REQUESTS=3
# AQUILA_READ_TIMEOUT_MAX=600
# AQUILA_TIMEOUT_PER_1K_TOKENS=5
# AQUILA_TIMEOUT_COMPRESS_RETRY=1
# AQUILA_EXPECTED_TOKENS_PER_S=30
# AQUILA_TQ_EXPECTED_TOKENS_PER_S=30
# AQUILA_TQ_PRESET=tq4

# Stream guard — Repetition detection during streaming.
# AQUILA_STREAM_GUARD=1
# AQUILA_STREAM_MIN_CHECK_CHARS=200
# AQUILA_STREAM_LINE_REPEAT_MIN=4
# AQUILA_STREAM_LINE_DOMINANCE=0.30
# AQUILA_SLOW_TPS_RATIO=0.5

# Instances & tools — Instance policy and optional tool surfaces.
# AQUILA_ACTIVE_INSTANCE=default
# AQUILA_CONVERSATION_ARCHIVE=1
# AQUILA_DIFF_REVIEW=1
# AQUILA_TERMINAL=0
# AQUILA_RUN_COMMAND=1
# AQUILA_ENABLE_DATA_PROCESSING=0
# AQUILA_DATA_MAX_FILE_MB=50
# AQUILA_DATA_MAX_CSV_ROWS=200
# AQUILA_MCP_DELIVERABLE_CAP=12000
# AQUILA_MCP_ALLOWED_MODES=autonomous,task,research,code,writing

# Code mode — simple chat loop limits and harness gating.
# AQUILA_CODE_MAX_TURNS=16
# AQUILA_CODE_MAX_WRITE_CHARS=8000
# AQUILA_CODE_MAX_CREATE_CHARS=12000
# AQUILA_CODE_MODEL_GATE=1
# AQUILA_CODE_ALLOW_DEGRADED_MODEL=0
# AQUILA_CODE_SESSION_LOG=1
# AQUILA_CODE_SNAPSHOT_MAX_CHARS=8000
# AQUILA_CODE_AUTO_CONTEXT=0
# AQUILA_CODE_AUTO_CONTEXT_MAX_CHARS=12000
# AQUILA_CODE_SEMANTIC_SEARCH=0

# Logging — Run logs and JSONL events.
# AQUILA_LOG_JSON=1
# AQUILA_LOG_FULL_TOOLS=0


# Ollama connection (export) — Also edited on AI Engine page; exported to .env for shell scripts.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=aquila_qwopus
# OLLAMA_NUM_CTX=
# OLLAMA_KEEP_ALIVE=30m

# SearXNG (export) — Also edited on Web Search page.
# SEARXNG_BASE_URL=http://127.0.0.1:8080
# SEARXNG_ENGINES=google,bing,duckduckgo,wikipedia
